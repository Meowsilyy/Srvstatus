+def apply_location_crosscheck(primary, secondary, registration, enabled):
+    if not primary and not secondary:
+        return primary, {"enabled": enabled, "status": "unavailable", "sources": []}
+    base = dict(primary or secondary or {})
+    if not enabled:
+        return base, {"enabled": False, "status": "off", "sources": []}
+    sources = []
+    for name, item in (("ipwho.is", primary), ("ipapi.co", secondary)):
+        if item and item.get("countryCode"):
+            sources.append({
+                "source": name,
+                "country": item.get("country"),
+                "countryCode": str(item.get("countryCode") or "").upper(),
+                "region": item.get("region"),
+                "city": item.get("city"),
+            })
+    if registration and registration.get("country"):
+        sources.append({
+            "source": "RDAP",
+            "country": None,
+            "countryCode": str(registration.get("country") or "").upper(),
+            "region": None,
+            "city": None,
+        })
+    counts = {}
+    for item in sources:
+        code = item.get("countryCode")
+        if code:
+            counts[code] = counts.get(code, 0) + 1
+    selected = max(counts, key=counts.get) if counts else None
+    best_count = counts.get(selected, 0) if selected else 0
+    if len(sources) <= 1:
+        status = "single-source"
+    elif best_count >= 2:
+        status = "confirmed"
+    else:
+        status = "conflict"
+    chosen = None
+    for item in (primary, secondary):
+        if item and str(item.get("countryCode") or "").upper() == selected:
+            chosen = item
+            break
+    if chosen:
+        for key in ("continent", "country", "countryCode", "region", "city", "latitude", "longitude", "postal", "timezone", "flag"):
+            if chosen.get(key) is not None:
+                base[key] = chosen.get(key)
+    verification = {
+        "enabled": True,
+        "status": status,
+        "selectedCountryCode": selected,
+        "agreement": f"{best_count}/{len(sources)}" if sources else None,
+        "sources": sources,
+    }
+    base["verification"] = verification
+    return base, verification
+
