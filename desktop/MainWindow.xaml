<Window x:Class="ServerStatusApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerStatus" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="1" CornerRadius="6">
            <Grid Margin="6">
              <Rectangle Height="4" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"/>
              <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"/>
            </Grid>
          </Border>
          <TextBlock Text="ServerStatus" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="RunStateText" Text="Idle" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <TextBlock Text="  ·  " Foreground="{DynamicResource BorderBrushApp}"/>
          <TextBlock x:Name="RunTimeText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Margin="0,0,8,0" Click="CancelButton_Click"/>
          <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="0,0,0,1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Target" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock x:Name="TargetHint" Text="Domain, URL, IP or Minecraft address" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="0,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TargetInput" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" KeyDown="TargetInput_KeyDown"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
            <RadioButton x:Name="ServerModeButton" Content="Server" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="Mode_Checked"/>
            <RadioButton x:Name="IpModeButton" Content="IP" VerticalAlignment="Center" Checked="Mode_Checked"/>
          </StackPanel>
        </Grid>
        <Button x:Name="LookupButton" Grid.Column="2" Content="Lookup" Padding="18,8" Click="LookupButton_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="196"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="0,0,1,0" Padding="12,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="REPORT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,9"/>
          <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
            <ListBox.Resources>
              <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.Resources>
          </ListBox>
          <StackPanel Grid.Row="2">
            <TextBlock Text="RECENT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="10,8,0,6"/>
            <ItemsControl x:Name="RecentItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Tag="{Binding}" Style="{StaticResource NavButtonStyle}" Click="RecentTarget_Click" FontFamily="Cascadia Mono, Consolas" FontSize="11" ToolTip="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" x:Name="ProgressStrip" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="0,0,0,1" Padding="16,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" Text="Starting lookup" FontSize="12"/>
            <ProgressBar Grid.Column="1" Width="150" Height="4" IsIndeterminate="True" Background="{DynamicResource PanelRaisedBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ContentHost" Margin="22,20,22,36">
            <TextBlock x:Name="SectionTitle" Text="Ready" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="SectionSubtitle" Text="Enter a target to inspect DNS, HTTP, TLS, routing, IP ownership, services, reputation and Minecraft status." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <StackPanel x:Name="SectionBody"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="SettingsPanel" Grid.Column="2" Width="350" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushApp}" BorderThickness="1,0,0,0" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Close" Padding="9,5" Click="CloseSettings_Click"/>
            </Grid>

            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
            <TextBlock Text="Theme" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ThemeCombo" SelectionChanged="Settings_Changed" Margin="0,0,0,10">
              <ComboBoxItem Content="Dark" Tag="dark"/>
              <ComboBoxItem Content="Light" Tag="light"/>
              <ComboBoxItem Content="System" Tag="system"/>
            </ComboBox>
            <CheckBox x:Name="CompactCheck" Content="Compact layout" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,16"/>

            <TextBlock Text="LOOKUP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
            <TextBlock Text="Service scan" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ScanModeCombo" SelectionChanged="Settings_Changed" Margin="0,0,0,10">
              <ComboBoxItem Content="Off" Tag="off"/>
              <ComboBoxItem Content="Common" Tag="common"/>
              <ComboBoxItem Content="Extended" Tag="extended"/>
            </ComboBox>
            <TextBlock Text="Port timeout" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ScanTimeoutCombo" SelectionChanged="Settings_Changed" Margin="0,0,0,10">
              <ComboBoxItem Content="250 ms" Tag="250"/>
              <ComboBoxItem Content="500 ms" Tag="500"/>
              <ComboBoxItem Content="900 ms" Tag="900"/>
            </ComboBox>
            <CheckBox x:Name="ShowClosedCheck" Content="Show closed services" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,7"/>
            <CheckBox x:Name="MinecraftCheck" Content="Minecraft Java + Bedrock" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,7"/>
            <CheckBox x:Name="LocationCrossCheckCheck" Content="Cross-check IP location sources" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,7"/>
            <CheckBox x:Name="DeepRoutingCheck" Content="Deep routing + traceroute" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,16"/>

            <TextBlock Text="LOCAL HISTORY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
            <CheckBox x:Name="RestoreLastCheck" Content="Restore last target on startup" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,7"/>
            <CheckBox x:Name="RecentCheck" Content="Remember recent targets" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,16"/>

            <TextBlock Text="OPTIONAL INTELLIGENCE APIS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="The app works without keys. Keys add richer security, reputation and indexed-service data." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
            <TextBlock Text="ipapi.is key" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="IpApiIsKeyBox" PasswordChanged="ApiKey_Changed" Margin="0,0,0,8"/>
            <TextBlock Text="AbuseIPDB key" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="AbuseKeyBox" PasswordChanged="ApiKey_Changed" Margin="0,0,0,8"/>
            <TextBlock Text="Shodan key" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ShodanKeyBox" PasswordChanged="ApiKey_Changed" Margin="0,0,0,8"/>
            <TextBlock Text="VirusTotal key" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="VirusTotalKeyBox" PasswordChanged="ApiKey_Changed" Margin="0,0,0,14"/>
            <Button Content="Clear recent targets" Click="ClearRecent_Click" Margin="0,0,0,8"/>
            <Button Content="Reset settings" Click="ResetSettings_Click"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
