<Application x:Class="ServerStatusApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0A0B0D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0F1114"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#14171B"/>
    <SolidColorBrush x:Key="BorderBrushApp" Color="#242830"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8C949E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8FA7C2"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A222B"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#9CC8AF"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D4B483"/>
    <SolidColorBrush x:Key="BadBrush" Color="#D38F8F"/>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SectionBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Application.Resources>
</Application>
